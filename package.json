{
  "name": "super-shop-pos",
  "productName": "Super Shop POS",
  "version": "1.0.0",
  "description": "Offline-first supermarket point of sale desktop application with Bangla and English support",
  "author": {
    "name": "Super Shop POS"
  },
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "dist-electron/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron": "electron .",
    "start": "vite build && electron .",
    "build:electron": "vite build && electron-builder --dir",
    "dist": "vite build && electron-builder",
    "dist:win": "vite build && electron-builder --win",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:linux": "vite build && electron-builder --linux",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vite build && playwright test",
    "art": "node scripts/generate-product-art.mjs",
    "icons": "node scripts/generate-icon.mjs",
    "shots": "node scripts/screenshots.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "electron-store": "^11.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/anek-bangla": "^5.2.0",
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "@fontsource-variable/noto-sans-bengali": "^5.3.0",
    "@fontsource/hind-siliguri": "^5.2.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.44.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.9.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.2",
    "vitest": "^5.0.0",
    "zustand": "^5.0.15"
  }
}
